# OpenClaw Custom - Environment Variables
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env with real secrets

# === Telegram ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# === LLM Providers (Frugal Routing) ===

# Groq - Quick/Fast inference (Llama3)
GROQ_API_KEY=gsk_your-groq-api-key

# Google Gemini - Embeddings and vision
GEMINI_API_KEY=your-gemini-api-key

# Mistral - General purpose (primary model)
MISTRAL_API_KEY=your-mistral-api-key

# Anthropic Claude - Reasoning tasks
CLAUDE_API_KEY=sk-ant-your-anthropic-key

# DeepSeek - Coding tasks
DEEPSEEK_API_KEY=sk-your-deepseek-key

# OpenAI - Fallback provider
OPENAI_API_KEY=sk-proj-your-openai-key

# HuggingFace - Misc/embeddings
HUGGINGFACE_ACCESS_TOKEN=hf_your-hf-token

# === Gateway ===
OPENCLAW_GATEWAY_TOKEN=generate-a-strong-random-token-here
SETUP_PASSWORD=generate-a-strong-setup-password-here

# === Railway/Deployment ===
PORT=8080
OPENCLAW_STATE_DIR=/data/.openclaw
OPENCLAW_WORKSPACE_DIR=/data/workspace
NODE_ENV=production
